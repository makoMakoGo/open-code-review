PORT=3007
BOT_TRIGGER_PHRASE=/ocr review
BOT_TRIGGER_PHRASES=/ocr review

ALLOWED_USERS=your-login,friend-login
ALLOWED_USER_IDS=
ALLOWED_REPO_OWNERS=your-login,friend-login

MAX_REVIEW_COMMENTS=30
JOB_TIMEOUT_MS=1200000
CLEANUP_WORKDIR=true
WEBHOOK_BODY_LIMIT_BYTES=1048576
LLM_PROXY_BODY_LIMIT_BYTES=67108864
BOT_REPO_ROOT=/data/repos

GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/config/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-random-hex

OCR_LLM_URL=https://api.anthropic.com
OCR_LLM_TOKEN=replace-with-llm-token
OCR_LLM_MODEL=claude-sonnet-4-6
OCR_USE_ANTHROPIC=true
OCR_LLM_AUTH_HEADER=x-api-key

# Optional local LLM proxy. Use only for private, container-local OCR traffic.
# If enabled, set OCR_LLM_URL=http://127.0.0.1:3007/llm/anthropic, OCR_LLM_AUTH_HEADER=authorization (or x-api-key), and OCR_LLM_TOKEN to LLM_PROXY_INTERNAL_TOKEN.
LLM_PROXY_TARGET_URL=
LLM_PROXY_USER_AGENT=open-code-review-github-app-bot/0.1.0
LLM_PROXY_X_APP=
LLM_PROXY_INTERNAL_TOKEN=
LLM_PROXY_UPSTREAM_AUTH_HEADER=
LLM_PROXY_UPSTREAM_TOKEN=

OCR_CONCURRENCY=1
OCR_MAX_GIT_PROCS=2
OCR_PER_FILE_TIMEOUT_MINUTES=10

# Optional embedded admin dashboard. Disabled unless ADMIN_PASSWORD is at least 16 characters.
ADMIN_PASSWORD=
ADMIN_DATA_DIR=/data/admin
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_TRUST_PROXY=false